#!/usr/bin/env bash
# Start, stop, and check everything needed to prompt the agent skills from any MCP client.
#
#   agents up       start Ollama (if the default model needs it), Hermes, and fast-agent;
#                   link the skills; register fast-agent with Claude Code and Codex
#   agents down     stop what `up` started
#   agents status   show what is running
#
# Logs and pid files live in ~/.local/state/agents. See README.md in this folder for the pieces.
set -euo pipefail

AGENTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agents"
CONFIG="$AGENTS_DIR/fast-agent.yaml"

HERMES_PORT=8642
FAST_AGENT_PORT=8810
OLLAMA_PORT=11434
MCP_NAME=fast-agent
MCP_URL="http://localhost:$FAST_AGENT_PORT/mcp"

mkdir -p "$STATE_DIR"

log() { printf '%s\n' "$*"; }
die() { printf 'agents: %s\n' "$*" >&2; exit 1; }

port_up() { nc -z 127.0.0.1 "$1" >/dev/null 2>&1; }

pid_alive() {
  local f="$STATE_DIR/$1.pid"
  [[ -f "$f" ]] && kill -0 "$(cat "$f")" 2>/dev/null
}

wait_for_port() {   # name port seconds
  local name=$1 port=$2 secs=$3
  for ((i = 0; i < secs; i++)); do
    port_up "$port" && return 0
    pid_alive "$name" || break
    sleep 1
  done
  log "  $name did not come up on :$port. Last log lines:"
  tail -n 20 "$STATE_DIR/$name.log" 2>/dev/null | sed 's/^/    /'
  return 1
}

start_bg() {   # name command...
  local name=$1; shift
  nohup "$@" >"$STATE_DIR/$name.log" 2>&1 &
  echo $! >"$STATE_DIR/$name.pid"
}

# Model the cards run on unless a card names its own: default_model in fast-agent.yaml.
default_model() {
  sed -n 's/^default_model:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' "$CONFIG" | head -n 1
}

link_skills() {
  local skill name target
  for skill in "$AGENTS_DIR"/*/SKILL.md; do
    [[ -e "$skill" ]] || continue
    name="$(basename "$(dirname "$skill")")"
    for target in "$HOME/.hermes/skills" "$HOME/.claude/skills" "$HOME/.codex/skills"; do
      mkdir -p "$target"
      ln -sfn "$AGENTS_DIR/$name" "$target/$name"
    done
    log "  skill $name linked for Hermes, Claude Code, Codex"
  done
}

register_clients() {
  if command -v claude >/dev/null; then
    if claude mcp get "$MCP_NAME" >/dev/null 2>&1; then
      log "  Claude Code: $MCP_NAME already registered"
    else
      claude mcp add --scope user --transport http "$MCP_NAME" "$MCP_URL" >/dev/null
      log "  Claude Code: registered $MCP_NAME (restart Claude Code to see its tools)"
    fi
  fi
  if command -v codex >/dev/null; then
    if codex mcp list 2>/dev/null | grep -q "^$MCP_NAME\b"; then
      log "  Codex: $MCP_NAME already registered"
    else
      codex mcp add "$MCP_NAME" --url "$MCP_URL" >/dev/null
      log "  Codex: registered $MCP_NAME"
    fi
  fi
}

up() {
  [[ -f "$CONFIG" ]] || die "missing $CONFIG (see README.md, section 2)"
  [[ -f "$HOME/.hermes/.env" ]] || die "missing ~/.hermes/.env with API_SERVER_KEY"

  log "skills"
  link_skills

  local model
  model="$(default_model)"
  if [[ "$model" == generic.custom:* ]]; then
    log "ollama (default model $model is local)"
    if port_up "$OLLAMA_PORT"; then
      log "  already running"
    else
      command -v ollama >/dev/null || die "ollama not on PATH"
      start_bg ollama ollama serve
      wait_for_port ollama "$OLLAMA_PORT" 20
      log "  started"
    fi
    local ollama_model="${model#generic.custom:}"
    if ! ollama list 2>/dev/null | awk 'NR > 1 {print $1}' | grep -qx "$ollama_model\(:latest\)\{0,1\}"; then
      log "  pulling $ollama_model (first time only)"
      ollama pull "$ollama_model"
    fi
  fi

  log "hermes"
  if port_up "$HERMES_PORT"; then
    log "  already running on :$HERMES_PORT"
  else
    start_bg hermes hermes gateway run
    wait_for_port hermes "$HERMES_PORT" 60
    log "  started on :$HERMES_PORT"
  fi

  log "fast-agent"
  if port_up "$FAST_AGENT_PORT"; then
    log "  already running on :$FAST_AGENT_PORT"
  else
    local key
    key="$(sed -n 's/^API_SERVER_KEY=//p' "$HOME/.hermes/.env" | head -n 1)"
    [[ -n "$key" ]] || die "API_SERVER_KEY not set in ~/.hermes/.env"
    (cd "$STATE_DIR" && export GENERIC_API_KEY="$key" && start_bg fast-agent \
      uvx fast-agent-mcp serve -c "$CONFIG" --agent-cards "$AGENTS_DIR/cards" \
        --transport http --port "$FAST_AGENT_PORT")
    wait_for_port fast-agent "$FAST_AGENT_PORT" 120   # first run downloads fast-agent
    log "  started on :$FAST_AGENT_PORT"
  fi

  log "clients"
  register_clients

  log ""
  log "Ready. In Claude Code or Codex, ask for a task and name the agent, e.g."
  log "  \"Use haskell-coder to fix the GHC errors in ~/code/<project>\""
  log "Logs: $STATE_DIR"
}

down() {
  local name
  for name in fast-agent hermes ollama; do
    if pid_alive "$name"; then
      kill "$(cat "$STATE_DIR/$name.pid")"
      log "stopped $name"
    fi
    rm -f "$STATE_DIR/$name.pid"
  done
}

status() {
  local name port
  for pair in "ollama:$OLLAMA_PORT" "hermes:$HERMES_PORT" "fast-agent:$FAST_AGENT_PORT"; do
    name="${pair%%:*}" port="${pair##*:}"
    if port_up "$port"; then
      if pid_alive "$name"; then
        log "$name  up on :$port (started by agents, pid $(cat "$STATE_DIR/$name.pid"))"
      else
        log "$name  up on :$port (started elsewhere; \`agents down\` leaves it alone)"
      fi
    else
      log "$name  down"
    fi
  done
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  status) status ;;
  *) die "usage: agents up|down|status" ;;
esac
