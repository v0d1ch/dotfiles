font-size = 13

# Equivalent of kitty's copy_or_interrupt: copies when a selection exists,
# otherwise the key passes through as a normal Ctrl+C interrupt
keybind = performable:ctrl+c=copy_to_clipboard

# Paper: custom light theme in themes/Paper, styled after Kindle e-ink —
# warm cream background (#f0e9d8), sepia ink (#322e26), muted print-like
# accents. Same palette as the herdr and nixvim "paper" themes.
theme = Paper
window-theme = light
