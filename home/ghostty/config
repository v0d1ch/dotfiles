font-size = 13

# Equivalent of kitty's copy_or_interrupt: copies when a selection exists,
# otherwise the key passes through as a normal Ctrl+C interrupt
keybind = performable:ctrl+c=copy_to_clipboard

# Typewriter: custom light theme in themes/Typewriter, matched to the
# Obsidian "Typewriter" theme — cream #fcf5e4, neutral ink #262626, green
# accent #459f58. Same palette as the herdr and nixvim "typewriter" themes.
# Alternative: Paper (themes/Paper, Kindle e-ink cream #f0e9d8 + sepia ink).
theme = Typewriter
window-theme = light
